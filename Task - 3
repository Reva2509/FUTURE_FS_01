  { name: "Paneer Sandwich", price: "₹160", category: "snacks", emoji: "🥪", desc: "Grilled paneer with mint chutney" },
  { name: "Loaded Nachos", price: "₹190", category: "snacks", emoji: "🧀", desc: "Crispy nachos with cheese & salsa" },
  { name: "Veg Club Sandwich", price: "₹180", category: "snacks", emoji: "🥙", desc: "Triple-decker with fresh veggies" },
  { name: "Chocolate Brownie", price: "₹150", category: "desserts", emoji: "🍫", desc: "Warm fudgy brownie with ice cream" },
  { name: "Tiramisu", price: "₹280", category: "desserts", emoji: "🍰", desc: "Classic Italian coffee-flavored layers" },
];

const faqData = [
  { q: "Do you offer vegan options?", a: "Yes! We have oat milk, almond milk, and several vegan food items on our menu." },
  { q: "Is there parking available?", a: "Yes, we have free parking for both two-wheelers and cars right next to the cafe." },
  { q: "Can I book the cafe for private events?", a: "Absolutely! We offer private event bookings for groups of 20-50 people. Contact us for details." },
  { q: "Do you have a loyalty program?", a: "Yes! Every 10th coffee is free. Ask our staff about our HotCup Rewards card." },
  { q: "Is Wi-Fi free for all customers?", a: "Yes, high-speed Wi-Fi is complimentary for all customers with no time limit." },
];

// Render Menu
function renderMenu(filter = 'all') {
  const grid = document.getElementById('menu-grid');
  const filtered = filter === 'all' ? menuItems : menuItems.filter(i => i.category === filter);
  grid.innerHTML = filtered.map(item => `
    <div class="menu-card p-6 rounded-2xl" style="background: #FFF; box-shadow: 0 4px 20px rgba(45,24,16,0.06);">
      <div class="flex items-start justify-between mb-3">
        <span class="text-4xl">${item.emoji}</span>
        <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background: #D4553A15; color: #D4553A;">${item.price}</span>
      </div>
      <h3 class="font-semibold mb-1" style="color: #2D1810;">${item.name}</h3>
      <p class="text-sm" style="color: #5C4033;">${item.desc}</p>
    </div>
  `).join('');
}

// Render FAQ
function renderFAQ() {
  const container = document.getElementById('faq-container');
  container.innerHTML = faqData.map((item, i) => `
    <div class="faq-item rounded-xl overflow-hidden" style="background: #FFF;">
      <button onclick="toggleFAQ(${i})" class="w-full flex items-center justify-between p-5 text-left">
        <span class="font-medium text-sm" style="color: #2D1810;">${item.q}</span>
        <i data-lucide="chevron-down" class="w-4 h-4 flex-shrink-0 transition-transform faq-icon-${i}" style="color: #D4553A;"></i>
      </button>
      <div id="faq-answer-${i}" class="hidden px-5 pb-5">
        <p class="text-sm" style="color: #5C4033;">${item.a}</p>
      </div>
    </div>
  `).join('');
  lucide.createIcons();
}

function toggleFAQ(i) {
  const answer = document.getElementById(`faq-answer-${i}`);
  answer.classList.toggle('hidden');
}

// Filter buttons
document.getElementById('filter-btns').addEventListener('click', (e) => {
  if (e.target.classList.contains('filter-btn')) {
    document.querySelectorAll('.filter-btn').forEach(b => { b.classList.remove('active'); b.style.background = '#FFF'; b.style.color = '#2D1810'; });
    e.target.classList.add('active');
    e.target.style.background = '#2D1810';
    e.target.style.color = '#FFF';
    renderMenu(e.target.dataset.filter);
  }
});

// Mobile menu
document.getElementById('mobile-toggle').addEventListener('click', () => {
  document.getElementById('mobile-menu').classList.toggle('hidden');
});
document.querySelectorAll('#mobile-menu a').forEach(a => a.addEventListener('click', () => document.getElementById('mobile-menu').classList.add('hidden')));

// Contact Form
document.getElementById('contact-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('contact-submit');
  const status = document.getElementById('form-status');
  btn.disabled = true; btn.textContent = 'Sending...';
  const result = await window.dataSdk.create({
    name: document.getElementById('c-name').value,
    email: document.getElementById('c-email').value,
    phone: document.getElementById('c-phone').value || '',
    message: document.getElementById('c-msg').value,
    type: 'contact',
    submitted_at: new Date().toISOString()
  });
  btn.disabled = false; btn.textContent = 'Send Message';
  status.classList.remove('hidden');
  if (result.isOk) {
    status.textContent = '✅ Message sent successfully! We\'ll get back to you soon.';
    status.style.color = '#16a34a'; status.style.background = '#f0fdf4';
    e.target.reset();
  } else {
    status.textContent = '❌ Something went wrong. Please try again.';
    status.style.color = '#dc2626'; status.style.background = '#fef2f2';
  }
  setTimeout(() => status.classList.add('hidden'), 4000);
});

// Newsletter
document.getElementById('newsletter-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const status = document.getElementById('newsletter-status');
  const email = e.target.querySelector('input').value;
  const result = await window.dataSdk.create({ name: '', email, phone: '', message: '', type: 'newsletter', submitted_at: new Date().toISOString() });
  status.classList.remove('hidden');
  status.textContent = result.isOk ? '🎉 Subscribed! Welcome to the HotCup family.' : 'Something went wrong. Try again.';
  if (result.isOk) e.target.reset();
  setTimeout(() => status.classList.add('hidden'), 4000);
});

