  { name: "Cold Brew", price: "₹200", category: "coffee", emoji: "🧊", desc: "Slow-steeped 18-hour cold brew" },
  { name: "Caramel Latte", price: "₹220", category: "coffee", emoji: "🍯", desc: "Smooth latte with house-made caramel" },
